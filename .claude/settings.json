{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/backend/.venv/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_paths.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/backend/.venv/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_pytest.py\"",
            "timeout": 300,
            "statusMessage": "Running backend tests..."
          }
        ]
      }
    ]
  }
}
