# Copy to .env.local. NEXT_PUBLIC_* values are baked in when `npm run dev` / `npm run build`
# starts, so restart the dev server after changing them.

# FastAPI backend (backend/, `uvicorn app.main:app --port 8000`)
NEXT_PUBLIC_API_URL=http://localhost:8000

# true = run fully offline on the localStorage mock in lib/api.ts (no backend needed).
# Anything else (or unset) = call the real backend.
NEXT_PUBLIC_USE_MOCK_API=false
