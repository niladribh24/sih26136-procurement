# Copy to .env and fill in real values. Never commit .env.
# If the postgres password contains @ : / # or %, URL-encode it (e.g. @ -> %40).
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/sih_db
JWT_SECRET=change-me-to-a-long-random-string
# Optional, defaults to 1440 (24h)
# JWT_EXPIRE_MINUTES=1440
ML_SERVICE_URL=http://localhost:8001
# Optional, defaults to 60 (seconds per ML call)
# ML_TIMEOUT_SECONDS=60
FRONTEND_URL=http://localhost:3000
# Optional, defaults to backend/uploads
# UPLOAD_DIR=C:/path/to/uploads
